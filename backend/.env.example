# Database Configuration (XAMPP defaults)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=document_search

# Server Configuration
PORT=5001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM API Configuration - Groq
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_SELECTOR_MODEL=llama-3.1-8b-instant
GROQ_ANSWER_MODEL=llama-3.3-70b-versatile

# Documents folder path (relative to backend)
DOCUMENTS_PATH=../generated_documents
